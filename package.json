{
  "name": "turbo-headshots",
  "version": "2.6.1",
  "description": "Headshot registration system for tethered photography",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:v1": "TURBO_V1=1 electron .",
    "dev": "concurrently -k \"vite --config renderer/vite.config.ts\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build:renderer": "vite build --config renderer/vite.config.ts",
    "build": "npm run build:renderer && electron-builder --mac",
    "build-dmg": "npm run build:renderer && electron-builder --mac dmg"
  },
  "author": "Turbo 360",
  "license": "MIT",
  "devDependencies": {
    "@electron/notarize": "^2.2.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "wait-on": "^9.1.0",
    "zustand": "^5.0.15"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "chokidar": "^3.5.3",
    "electron-updater": "^6.7.3",
    "sharp": "^0.33.0"
  },
  "build": {
    "appId": "com.turbo360.headshots",
    "productName": "Turbo Headshots",
    "artifactName": "${name}-${version}-${arch}.${ext}",
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "mac": {
      "category": "public.app-category.photography",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "identity": "James Anderson (ETURVK9WSA)",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "binaries": [
        "Contents/Resources/HeadshotSidecar"
      ],
      "notarize": {
        "teamId": "ETURVK9WSA"
      },
      "x64ArchFiles": "Contents/Resources/HeadshotSidecar",
      "icon": "build/icon.icns"
    },
    "extraResources": [
      {
        "from": "sidecar/.build/release/HeadshotSidecar",
        "to": "HeadshotSidecar"
      }
    ],
    "dmg": {
      "title": "Turbo Headshots",
      "sign": false,
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "icon": "build/dmg-icon.icns"
    },
    "files": [
      "main.js",
      "main-v1.js",
      "main-v2.js",
      "preload.js",
      "main/**",
      "engine/**",
      "gallery-client.js",
      "sidecar-client.js",
      "replicate.js",
      "processor.js",
      "index.html",
      "logo.png",
      "package.json",
      "renderer/dist/**",
      "!**/*.md"
    ],
    "publish": {
      "provider": "github",
      "owner": "turbo360",
      "repo": "Turbo-Headshots"
    }
  }
}
